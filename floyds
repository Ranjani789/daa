#include <iostream>
#include <string>
#include <cstdlib>
using namespace std;
const int INF = 99999;
int main() {
    int n;
    int d[10][10];
    string X;
    cout << "Enter number of vertices: ";
    cin >> n;
    cout << "Enter cost matrix (INF for no edge):" << endl;
    for (int i = 0; i < n; i++){
        for (int j = 0; j < n; j++){
            cin >> X;
            if (X == "INF"){
                d[i][j] = INF;
            }
            else{
                d[i][j] = atoi(X.c_str());
            }  }  }
    for (int k = 0; k < n; k++){
        for (int i = 0; i < n; i++){
            for (int j = 0; j < n; j++){
                if (d[i][k] != INF && d[k][j] != INF){
                    if (d[i][k] + d[k][j] < d[i][j]){
                        d[i][j] = d[i][k] + d[k][j];
                    }  }
            }  }
    }
    cout << endl;
    cout << "Shortest Distance Matrix:" << endl;
    for (int i = 0; i < n; i++){
        for (int j = 0; j < n; j++){
            if (d[i][j] == INF){
                cout << "INF\t";
            }
            else{
                cout << d[i][j] << "\t";
            }  }
        cout << endl;
    }
    return 0;
}
