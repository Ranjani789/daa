#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int n, target;
int a[20];
int subset[20];
int subsetSize = 0;
void sumOfSubsets(int index, int currentSum){
    if (currentSum == target) {
        cout << "{ ";       
        for (int i = 0; i < subsetSize; i++){
            cout << subset[i] << " ";
        }       
        cout << "}" << endl;
        return;
    }
    if (index == n || currentSum > target)
        return;
    if (currentSum + a[index] <= target)  {
        subset[subsetSize] = a[index];
        subsetSize++;
        sumOfSubsets(index + 1, currentSum + a[index]);
        subsetSize--;
    }
    sumOfSubsets(index + 1, currentSum);
}
int main() {
    cout << "Enter number of elements: ";
    cin >> n;
    cout << "Enter the elements: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    cout << "Enter target sum: ";
    cin >> target;
    sort(a, a + n);
    cout << "\nSubsets with sum " << target << " are:\n";
    sumOfSubsets(0, 0);
    return 0;
}
