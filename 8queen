#include <iostream>
using namespace std;
int board[8][8];
bool isSafe(int row, int col) {
    int i, j;
    for (i = 0; i < row; i++) {
        if (board[i][col] == 1)
            return false;
    }
    for (i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--) {
        if (board[i][j] == 1)
            return false;
    }
    for (i = row - 1, j = col + 1; i >= 0 && j < 8; i--, j++) {
        if (board[i][j] == 1)
            return false;
    }
    return true;
}
bool solveNQueens(int row) {
    int col;
    if (row == 8)
        return true;
    for (col = 0; col < 8; col++) {
        if (isSafe(row, col))  {
            board[row][col] = 1;
            if (solveNQueens(row + 1))
                return true;
            board[row][col] = 0;
        }   }
    return false;
}
int main() {
    int i, j;
    for (i = 0; i < 8; i++)  {
        for (j = 0; j < 8; j++)   {
            board[i][j] = 0;
        }    }
    if (solveNQueens(0))  {
        cout << "Solution for 8 Queens Problem:\n\n";
        for (i = 0; i < 8; i++)  {
            for (j = 0; j < 8; j++)  {
                if (board[i][j] == 1)
                    cout << " Q ";
                else
                    cout << " . ";
            }
            cout << endl;
        }    }
    else {
        cout << "No solution exists.";
    }
    return 0;
}
